table top_20_population_gold_v3
	lineageTag: fddaf395-e58c-48a4-a250-49bd268ddb26
	sourceLineageTag: [dbo].[top_20_population_gold_v3]

	measure 'Latest Population' =
			
			VAR MaxTimestamp = MAX('top_20_population_gold_v3'[Scrape_Timestamp])
			RETURN
			CALCULATE(
			    SUM('top_20_population_gold_v3'[Population_2025_Live]),
			    'top_20_population_gold_v3'[Scrape_Timestamp] = MaxTimestamp
			)
		formatString: #,0
		lineageTag: bfd2b0dc-e3a3-4abc-aaa2-628c34cc8cf0

		changedProperty = Name

		changedProperty = FormatString

	measure 'Total Snapshots' = COUNTROWS('top_20_population_gold_v3')
		formatString: 0
		lineageTag: 690ae566-493d-4d42-b8b7-1b8b958dc11e

		changedProperty = Name

	measure 'Total Runs' = DISTINCTCOUNT('top_20_population_gold_v3'[Scrape_Timestamp])
		formatString: 0
		lineageTag: 47b6203e-57c8-4a67-ad64-cf42f5607365

		changedProperty = Name

	measure 'Growth Per Snapshot' =
			
			AVERAGEX(
			    VALUES('top_20_population_gold_v3'[Scrape_Timestamp]),
			    [Latest Population] - AVERAGE('top_20_population_gold_v3'[Base_Pop])
			)
		lineageTag: bfb28588-a2a8-4032-815b-56095a2170d9

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

